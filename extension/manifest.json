{
  "manifest_version": 3,
  "name": "Send to TV",
  "version": "1.1.0",
  "description": "Finds the video a web page is playing and plays it on your TV (DLNA, e.g. Samsung) at full quality, with subtitles, via a small Mac helper.",
  "permissions": ["webRequest", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["hook.js"], "run_at": "document_start",
      "all_frames": true, "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["relay.js"], "run_at": "document_start",
      "all_frames": true }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Send to TV" },
  "icons": { "128": "icon128.png", "48": "icon48.png", "16": "icon16.png" },
  "commands": {
    "toggle-play": {
      "suggested_key": { "default": "Alt+Shift+P", "mac": "Alt+Shift+P" },
      "description": "Play / pause on the TV"
    },
    "skip-forward": {
      "suggested_key": { "default": "Alt+Shift+Right", "mac": "Alt+Shift+Right" },
      "description": "Skip forward 30 seconds on the TV"
    },
    "skip-back": {
      "suggested_key": { "default": "Alt+Shift+Left", "mac": "Alt+Shift+Left" },
      "description": "Skip back 10 seconds on the TV"
    }
  }
}
